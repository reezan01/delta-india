# Copy to .env. Never commit .env.

# prod    -> https://api.india.delta.exchange      (keys from www.delta.exchange, India account)
# testnet -> https://cdn-ind.testnet.deltaex.org   (keys from demo.delta.exchange)
# A key only works on the environment it was created on.
DELTA_ENV=prod

# Only needed for `delta balances` / `delta positions`. Public data needs no key.
# Create the key with READ-ONLY permission — this project never places orders.
DELTA_API_KEY=
DELTA_API_SECRET=

# Where candles and stream captures are written.
DELTA_DATA_DIR=./data
